# FROM node:14.16.0-alpine3.12
# FROM node:18.15.0-alpine3.17
# FROM node:lts-alpine3.20  # Node 20.14.0

# NODE VERSION is 26.x. 25.x went EOL June 2026 and never received the
# CVE-2026-111497 (Brotli RCE) fix; 26.12.1+ is patched. Rebuild with --pull.
FROM node:26-alpine

RUN apk add --no-cache git
# python3 + lxml run util-service/scripts/safe_xslt.py (MARC preview), which
# replaced the xsltproc CLI: xsltproc cannot parse untrusted XML safely.
# py3-lxml brings in libxslt, so no separate libxslt install is needed.
RUN apk add --no-cache python3 py3-lxml

RUN npm install -g forever nodemon @vue/cli @vue/cli-service-global grunt marcjs

WORKDIR /app

ENTRYPOINT ["/app/startup.sh"]
